{
  "name": "@heynaija/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": ["dist", "drizzle"],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && ../../infra/scripts/with-test-db.sh node --test --test-concurrency=1 'dist/**/*.test.js'",
    "generate": "drizzle-kit generate",
    "migrate": "node --env-file=../../.env dist/migrate.js",
    "seed": "node --env-file=../../.env dist/seed.js"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
