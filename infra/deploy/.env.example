# Settings for one deployment (staging or production). Copy with ./gen-env.sh,
# which fills in the random secrets; then fill in the rest by hand.
# Never commit the real .env. Keep a copy in the password manager.

# --- This deployment ------------------------------------------------------
# Keeps this deployment's containers, network and volumes separate from anything
# else on the server (Koinovera, on staging). heynaija-production in production.
COMPOSE_PROJECT_NAME=heynaija-staging
# production or staging. Picks each feature flag's default (docs/feature-flags.md):
# staging has every feature on, production only what is launched. This template says
# production on purpose, so a server whose .env was copied from it and not edited
# can never switch on unlaunched features: set staging on the staging server.
APP_ENV=production
# The branch this server follows: staging here, main in production.
DEPLOY_BRANCH=staging
SITE_URL=https://staging.heynaija.ng
# The host name nginx answers to.
SITE_ADDRESS=staging.heynaija.ng
# noindex on staging; index in production.
ROBOTS=noindex
# The one port published on the host, on 127.0.0.1, for nginx. Koinovera uses
# 3001, 8000 and 4433 on the staging server; keep clear of those.
WEB_PORT=3100
# Where the images built by GitHub Actions live: ghcr.io/<lowercase owner>/heynaija.
# Deploys pull ${IMAGE_PREFIX}-api:<commit> and ${IMAGE_PREFIX}-web:<commit>.
IMAGE_PREFIX=ghcr.io/<owner>/heynaija

# --- nginx (render-nginx.sh) -----------------------------------------------
# Cloudflare origin certificate and key, and Cloudflare's origin-pull CA.
NGINX_CERT=/etc/ssl/cloudflare/heynaija-origin.pem
NGINX_CERT_KEY=/etc/ssl/cloudflare/heynaija-origin-key.pem
NGINX_CLIENT_CA=/etc/ssl/cloudflare/authenticated_origin_pull_ca.pem
# The media bucket's public custom domain; nginx serves it under /media.
MEDIA_ORIGIN=https://media-staging.heynaija.ng
# The LiveKit server's addresses, comma-separated with no spaces: the only senders
# nginx lets post LiveKit's webhook (docs/deployment/livekit.md). Unset: nobody.
# LIVEKIT_WEBHOOK_FROM=

# --- Postgres memory -------------------------------------------------------
# compose.yml defaults to production's 16 GB server (4GB / 10GB / 16MB / 512MB).
# Staging shares its server with Koinovera, so it uses much less. In production,
# delete these lines to get the defaults.
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=768MB
POSTGRES_WORK_MEM=4MB
POSTGRES_MAINTENANCE_WORK_MEM=64MB
# API connections to Postgres (compose.yml default: 20).
DATABASE_POOL_MAX=10
# How long a migration waits for a table lock before the deploy's migrate step gives
# up and retries (milliseconds; compose.yml default: 5000; 0 waits forever). Raise it
# if a needed ALTER on a busy table keeps timing out.
#MIGRATE_LOCK_TIMEOUT_MS=5000
# Web server processes, one core each (compose.yml default: 1; production: 4).
WEB_WORKERS=1

# --- Generated by gen-env.sh ----------------------------------------------
POSTGRES_PASSWORD=
REDIS_PASSWORD=
KRATOS_SECRETS_COOKIE=
KRATOS_SECRETS_CIPHER=
KRATOS_WEBHOOK_SECRET=

# --- Cloudflare R2 (docs/deployment/cloudflare-r2.md) ------------------------
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_UPLOADS_BUCKET=heynaija-staging-uploads
S3_MEDIA_BUCKET=heynaija-staging-media

# --- Email through Resend (docs/deployment/staging.md, step 5) --------------
# Kratos sends sign-in codes with these, and the API sends notification emails
# with the same three (docs/adr/0009-notification-emails.md).
# smtps://resend:<API key>@smtp.resend.com:465/
SMTP_CONNECTION_URI=smtps://resend:<RESEND_API_KEY>@smtp.resend.com:465/
SMTP_FROM_ADDRESS=no-reply@mail.heynaija.ng
SMTP_FROM_NAME=HeyNaija

# --- Push notifications (docs/adr/0011-push-notifications.md) ---------------
# A VAPID key pair, made by gen-env.sh. Keep it, and keep a copy: a new pair cuts
# off every browser that has turned push on, until each turns it on again.
# Delete both lines to run without push.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=

# --- Calls and Gists (docs/adr/0017-calls-and-meetings.md) -----------------
# Dark. Leave all of these unset: there is no media server on this host, and with the
# switches false every Gists route answers 404. When a LiveKit server exists, its
# address and keys go here, CALLS_ENABLED and CALLS_GISTS_ENABLED become true, and
# CALLS_MEMBERS lists the handles allowed during the beta (comma-separated).
# CALLS_ENABLED=false
# CALLS_GISTS_ENABLED=false
# CALLS_MEMBERS=
# LIVEKIT_URL=wss://rtc.example.com
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_WEBHOOK_KEY=
# LIVEKIT_WEBHOOK_SECRET=

# --- Safety (docs/safety/abuse-material-scanning.md) ------------------------
# Where alerts about blocked uploads and reports of illegal content are emailed.
# Read daily by whoever handles safety.
SAFETY_ALERT_EMAIL=contact@heynaija.ng
# Cloudflare: the heynaija.ng zone's ID (Overview page) and an API token allowed
# only Zone → Cache Purge → Purge on that zone. Taken-down images are then purged
# from the cache under SITE_URL/media and MEDIA_ORIGIN.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_PURGE_TOKEN=
# Empty until Microsoft approves us; with a key, every upload is hash-matched
# before it is published.
PHOTODNA_SUBSCRIPTION_KEY=

# --- Account deletion and privacy requests (docs/adr/0016) ------------------
# Days between a member asking to delete their account and its erase (0 to 30),
# and days to answer a privacy request; empty means the default shown. Days
# deleted posts keep their text for moderation records: leave empty until counsel
# sets the period (docs/governance/counsel-log.md, C-04), and nothing is blanked.
ACCOUNT_DELETION_GRACE_DAYS=14
PRIVACY_REQUEST_DUE_DAYS=30
DELETED_CONTENT_RETENTION_DAYS=

# --- Video worker (docs/video-spike.md, docs/safety/video-scanning.md) --------
# Only used when started with `docker compose --profile video`. Production: 2 cores
# and 1.5g (ADR 0019 section 3.4). Staging shares its server: set 1 and 1g.
# VIDEO_WORKER_CPUS=2
# VIDEO_WORKER_MEMORY=1.5g
# Limits; unset means the ADR defaults (60 s, 100 MB, 1920 px, originals deleted).
# VIDEO_MAX_SECONDS=60   (at most 78)

# --- Google sign-in (docs/deployment/google-sign-in.md) ---------------------
# Off until the OAuth client exists; members can always sign in with an emailed code.
GOOGLE_SIGN_IN=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Backups (backup.sh) ----------------------------------------------------
# The age public key backups are encrypted to. Its private key is NOT on the server.
BACKUP_AGE_RECIPIENT=
# rclone destination: <remote>:<bucket>/<folder>
BACKUP_DESTINATION=r2backup:heynaija-backups/staging
BACKUP_KEEP_DAYS=30
# Optional: a monitoring URL pinged after each successful backup (for example a
# healthchecks.io check), which alerts you if backups stop.
BACKUP_PING_URL=
# Days Kratos's copies of the emails it sent are kept; backup.sh deletes older
# ones every night (kratos-cleanup.sh). Counsel to confirm the period
# (docs/governance/counsel-log.md, C-13). Empty means 7.
KRATOS_SENT_MAIL_KEEP_DAYS=7
