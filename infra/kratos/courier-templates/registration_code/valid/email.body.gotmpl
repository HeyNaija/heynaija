<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><meta name="supported-color-schemes" content="light dark"><title>Finish joining HeyNaija</title><style>:root{color-scheme:light dark;supported-color-schemes:light dark}@media (prefers-color-scheme:dark){.hn-ground{background:#0b1210!important}.hn-card{background:#111a17!important;border-color:#212d28!important}.hn-ink{color:#e6efe9!important}.hn-muted{color:#9dafa5!important}.hn-link{color:#7dd9aa!important}.hn-inset{background:#18231f!important}}</style></head>
<body class="hn-ground" style="margin:0;padding:0;background:#f1f4f2">
<div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;mso-hide:all">Enter the code from this email to finish creating your account. It expires in {{ .ExpiresInMinutes }} minutes.&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;</div>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" class="hn-ground" style="background:#f1f4f2"><tr><td align="center" style="padding:24px 12px">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:560px">
<tr><td class="hn-link" style="padding:0 4px 14px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Noto Sans',Helvetica,Arial,sans-serif;font-size:22px;font-weight:800;letter-spacing:-0.03em;color:#258153">HeyNaija</td></tr>
<tr><td class="hn-card" style="background:#ffffff;border:1px solid #e3e9e5;border-radius:12px;padding:24px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Noto Sans',Helvetica,Arial,sans-serif;font-size:15px;line-height:1.6;color:#10212b">
<p class="hn-ink" style="margin:0 0 14px;color:#10212b">Welcome to HeyNaija. Enter this code where you asked for it to finish creating your account:</p>
<p class="hn-ink hn-inset" style="margin:0 0 14px;padding:14px 16px;background:#f3f6f4;border-radius:8px;text-align:center;font-size:30px;font-weight:700;letter-spacing:6px;color:#10212b">{{ .RegistrationCode }}</p>
<p class="hn-ink" style="margin:0 0 14px;color:#10212b">It expires in {{ .ExpiresInMinutes }} minutes.</p>
<p class="hn-muted" style="margin:0;font-size:13px;color:#5c6b76">If you did not ask to join, ignore this email. No account is created without the code.</p>
</td></tr></table></td></tr></table></body></html>
