{
  "$id": "https://heynaija.example/schemas/member.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Member",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "title": "Email",
          "maxLength": 320,
          "ory.sh/kratos": {
            "credentials": { "password": { "identifier": true } },
            "verification": { "via": "email" },
            "recovery": { "via": "email" }
          }
        },
        "handle": {
          "type": "string",
          "title": "Handle",
          "pattern": "^[a-z0-9_]{3,20}$",
          "not": {
            "enum": ["admin", "administrator", "heynaija", "moderator", "mod", "support", "help", "staff", "official", "system", "root", "security"]
          },
          "ory.sh/kratos": {
            "credentials": { "password": { "identifier": true } }
          }
        }
      },
      "required": ["email", "handle"],
      "additionalProperties": false
    }
  }
}
