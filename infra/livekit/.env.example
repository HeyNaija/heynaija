# The LiveKit server's settings (docs/deployment/livekit.md). gen-env.sh copies
# this to .env and fills in the keys; never commit .env.

# The two DNS-only (grey cloud) names that point at this server.
LIVEKIT_DOMAIN=rtc-staging.heynaija.ng
TURN_DOMAIN=turn-staging.heynaija.ng

# Where LiveKit posts room and participant events: the API, through Cloudflare.
WEBHOOK_URL=https://staging.heynaija.ng/api/internal/livekit/webhook

# Let's Encrypt writes here about certificates that are about to expire.
ACME_EMAIL=contact@heynaija.ng

# Made by gen-env.sh. The API's .env holds the same four (printed when made).
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WEBHOOK_KEY=
LIVEKIT_WEBHOOK_SECRET=
