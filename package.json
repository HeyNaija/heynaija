{
  "name": "heynaija",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "governance:generate": "node --experimental-strip-types scripts/governance.mjs",
    "governance:check": "node --experimental-strip-types scripts/governance.mjs --check",
    "roadmap:generate": "node --experimental-strip-types scripts/roadmap.mjs",
    "roadmap:check": "node --experimental-strip-types scripts/roadmap.mjs --check",
    "roadmap:test": "node --experimental-strip-types --test scripts/roadmap.test.mjs",
    "migrations:check": "node --experimental-strip-types scripts/migrations.mjs",
    "migrations:test": "node --experimental-strip-types --test scripts/migrations.test.mjs",
    "db:check": "bash scripts/db-check.sh",
    "infra:env": "infra/scripts/gen-dev-env.sh",
    "infra:up": "docker compose --env-file .env -f infra/compose/docker-compose.dev.yml up -d --remove-orphans",
    "infra:livekit": "docker compose --env-file .env -f infra/compose/docker-compose.dev.yml --profile calls up -d livekit",
    "infra:down": "docker compose --env-file .env -f infra/compose/docker-compose.dev.yml down",
    "infra:logs": "docker compose --env-file .env -f infra/compose/docker-compose.dev.yml logs -f",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @heynaija/db generate",
    "db:migrate": "pnpm --filter @heynaija/db migrate",
    "dev:api": "pnpm --filter @heynaija/api dev",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "dev:web": "pnpm --filter @heynaija/web dev",
    "e2e": "pnpm --filter @heynaija/e2e e2e",
    "e2e:google": "pnpm --filter @heynaija/e2e e2e:google",
    "invite:create": "pnpm --silent --filter @heynaija/api build && pnpm --silent --filter @heynaija/api invite:create",
    "db:seed": "pnpm --filter @heynaija/db seed",
    "mod:grant": "pnpm --silent --filter @heynaija/api build && pnpm --silent --filter @heynaija/api moderator grant",
    "mod:revoke": "pnpm --silent --filter @heynaija/api build && pnpm --silent --filter @heynaija/api moderator revoke",
    "founder:grant": "pnpm --silent --filter @heynaija/api build && pnpm --silent --filter @heynaija/api founder grant",
    "founder:revoke": "pnpm --silent --filter @heynaija/api build && pnpm --silent --filter @heynaija/api founder revoke",
    "media:init": "pnpm --silent --filter @heynaija/api build && pnpm --silent --filter @heynaija/api media:init",
    "demo:seed": "pnpm --silent --filter @heynaija/api build && pnpm --silent --filter @heynaija/api demo:seed",
    "demo:clean": "pnpm --silent --filter @heynaija/api build && pnpm --silent --filter @heynaija/api demo:clean"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
