{
  "name": "@heynaija/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file=../../.env dist/main.js",
    "dev": "tsc -p tsconfig.json && (tsc -p tsconfig.json --watch --preserveWatchOutput & node --watch --env-file=../../.env dist/main.js)",
    "test": "pnpm build && ../../infra/scripts/with-test-db.sh node --test --test-concurrency=1 'dist/**/*.test.js'",
    "invite:create": "node --env-file=../../.env dist/cli/create-invite.js",
    "moderator": "node --env-file=../../.env dist/cli/moderator.js",
    "founder": "node --env-file=../../.env dist/cli/founder.js",
    "privacy-request": "node --env-file=../../.env dist/cli/privacy-request.js",
    "media:init": "node --env-file=../../.env dist/cli/media-init.js",
    "demo:seed": "node --env-file=../../.env dist/cli/seed-demo.js",
    "demo:clean": "node --env-file=../../.env dist/cli/seed-demo.js --clean"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1151.0",
    "@aws-sdk/s3-request-presigner": "^3.1151.0",
    "@fastify/cookie": "^11.1.3",
    "@heynaija/db": "workspace:*",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-fastify": "^12.1.3",
    "bullmq": "^6.3.15",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "ioredis": "^5.11.1",
    "livekit-server-sdk": "^2.19.2",
    "nodemailer": "^10.1.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/web-push": "^3.6.4"
  }
}
