# Do not fill this in by hand for local development:
#   pnpm infra:env     creates .env (or tops it up) with fresh random secrets
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Ory Kratos: cookie signing key, 32-character encryption key, and the shared
# secret Kratos presents when it calls the API's registration webhooks.
KRATOS_SECRETS_COOKIE=
KRATOS_SECRETS_CIPHER=
KRATOS_WEBHOOK_SECRET=

DATABASE_URL=postgres://heynaija:<POSTGRES_PASSWORD>@localhost:5433/heynaija
REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6380
KRATOS_PUBLIC_URL=http://127.0.0.1:4533

# Object storage for uploaded media. Locally this is MinIO; in production, Cloudflare
# R2 (endpoint https://<account-id>.r2.cloudflarestorage.com, region "auto").
# Two buckets: raw uploads stay private, processed media is publicly readable.
S3_ENDPOINT=http://127.0.0.1:9100
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=heynaija-dev
S3_SECRET_ACCESS_KEY=
S3_UPLOADS_BUCKET=heynaija-uploads
S3_MEDIA_BUCKET=heynaija-media

# Google sign-in: off unless you set these (docs/deployment/google-sign-in.md).
# GOOGLE_SIGN_IN=true
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Notification emails. Locally Mailpit catches them (inbox http://127.0.0.1:8026), as it
# does Kratos's sign-in codes; in staging and production they go through Resend with the
# same SMTP_* values Kratos uses (infra/deploy/.env.example). Without SMTP_CONNECTION_URI
# no email is sent. KRATOS_ADMIN_URL is Kratos's admin API, which keeps members' addresses;
# keep it on the private network.
KRATOS_ADMIN_URL=http://127.0.0.1:4534
SMTP_CONNECTION_URI=smtp://127.0.0.1:1026
SMTP_FROM_ADDRESS=no-reply@heynaija.test
SMTP_FROM_NAME=HeyNaija
# Seconds a notification waits for company before it is emailed, the least time between two
# emails to one member, and how often due emails are looked for (defaults 300, 1800, 60).
# To try it by hand: EMAIL_DIGEST_DELAY_S=10 EMAIL_DIGEST_GAP_S=30 EMAIL_SWEEP_EVERY_S=5
# EMAIL_DIGEST_DELAY_S=300
# EMAIL_DIGEST_GAP_S=1800
# EMAIL_SWEEP_EVERY_S=60

# Push notifications (docs/adr/0011). `pnpm infra:env` makes the VAPID key pair; without
# it nothing is pushed and Settings does not offer push. PUSH_CONTACT is how push services
# reach whoever sends (a mailto: or https: address; WEB_PUBLIC_URL when that is https).
# PUSH_ALLOW_LOOPBACK lets the end-to-end tests stand in for the push service on 127.0.0.1.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_CONTACT=mailto:no-reply@heynaija.test
PUSH_ALLOW_LOOPBACK=true
# Seconds between looks for notifications to push (default 10).
PUSH_SWEEP_EVERY_S=2

# Calls and Gists (docs/adr/0017), dark by default. `pnpm infra:env` makes the LiveKit keys and
# `pnpm infra:livekit` starts the server. Gists are live only with both switches true, the
# LIVEKIT_* settings present, and for members whose handle is in CALLS_MEMBERS (comma-separated;
# a temporary beta allow-list). Webhooks may be signed with a key of their own, else the API key.
# CALLS_ENABLED=false
# CALLS_GISTS_ENABLED=false
# CALLS_MEMBERS=
# LIVEKIT_URL=ws://127.0.0.1:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=
# LIVEKIT_WEBHOOK_KEY=devhook
# LIVEKIT_WEBHOOK_SECRET=
# Age verification with Didit (docs/deployment/age-verification.md), behind the `ageVerification`
# flag. All three or none; with any missing, no check is offered and the webhook answers 404.
# DIDIT_API_KEY=
# DIDIT_WORKFLOW_ID=
# DIDIT_WEBHOOK_SECRET=
# Gists limits (defaults shown): co-hosts, speakers besides the host, listeners per Gist.
# GISTS_MAX_COHOSTS=2
# GISTS_MAX_SPEAKERS=10
# GISTS_LISTENER_CAP=200

# Optional (defaults shown). WEB_PUBLIC_URL is the address members use: the API
# accepts writes only from it, and the web app puts it in link previews.
# WEB_PUBLIC_URL=http://127.0.0.1:3000
# API_PORT=4000

# Governance switches. They must stay false: the API refuses to start with any
# of them set to true until the approvals in docs/governance/open-items.md exist.
# NIN_VERIFICATION_ENABLED=false
# BINDING_GOVERNANCE_VOTING_ENABLED=false
# UNDER_18_ACCOUNTS_ENABLED=false
