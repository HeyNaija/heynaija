# Do not fill this in by hand for local development:
#   pnpm infra:env     creates .env (or tops it up) with fresh random secrets
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Ory Kratos: cookie signing key, 32-character encryption key, and the shared
# secret Kratos presents when it calls the API's registration webhooks.
KRATOS_SECRETS_COOKIE=
KRATOS_SECRETS_CIPHER=
KRATOS_WEBHOOK_SECRET=

DATABASE_URL=postgres://heynaija:<POSTGRES_PASSWORD>@localhost:5433/heynaija
REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6380
KRATOS_PUBLIC_URL=http://127.0.0.1:4533

# Optional (defaults shown)
# WEB_PUBLIC_URL=http://127.0.0.1:3000
# API_PORT=4000
